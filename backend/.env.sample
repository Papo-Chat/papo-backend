SERVER_PORT=8080
# Porta UDP para MUX, 0 desliga
VOICE_ICE_UDP_PORT=50000

DATABASE_URL=postgres://papo:papo123@localhost:5432/papo

JWT_SECRET=troque_por_um_segredo_aleatorio
HMAC_SECRET=segredo_de_midia_unguessable
TURN_SECRET=troque_por_outro_segredo

BASE_URL=https://papo.com/

MAX_USERNAME_LENGTH=16
MAX_PASSWORD_LENGTH=64

AUTH_RATE_LIMIT=5
AUTH_RATE_BURST=10
RATE_LIMIT=20
RATE_BURST=40
CORS_ORIGINS=http://localhost:5173,https://localhost:5173
SAME_SITE=true

THUMBNAIL_ENABLED=true

# Use CLOUDFLARE_PROXY=true somente quando o backend recebe conexões
# DIRETAMENTE do proxy Cloudflare.
CLOUDFLARE_PROXY=false

# Quando houver nginx/Caddy/HAProxy entre a internet e o backend, mantenha
# CLOUDFLARE_PROXY=false e liste aqui somente as redes do reverse proxy.
# O backend aceitará X-Real-IP exclusivamente dessas redes.
# Exemplo para nginx local:
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=
# Moderação assíncrona de imagens. Desativada por padrão;
# requer Python 3.10+ com `pip install -r moderation_worker/requirements.txt`.
# off | flag | blur | block (block exclui a mensagem).
MODERATION_ENABLED=false

MODERATION_NUDITY_MODE=block
MODERATION_GORE_MODE=block
MODERATION_NUDITY_THRESHOLD=0.8
MODERATION_GORE_THRESHOLD=0.8

# se usar python env tem que configurar para o endereço do python do env
#MODERATION_WORKER_COMMAND=moderation_worker/<env>/bin/python3
MODERATION_WORKER_COMMAND=python3

# Voz/câmera (SFU embutido). Sem TURN_URLS a sala usa só STUN (funciona em
# redes sem NAT restritivo); com TURN_URLS o TURN_SECRET (HMAC, ≥ 32 bytes)
# é obrigatório para gerar credenciais efêmeras (RFC 5389).
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_TTL_SECONDS=3600

VOICE_VIDEO_CODEC=vp8
VOICE_VIDEO_SLOTS=6
VOICE_AUDIO_SLOTS=8
VOICE_MAX_ROOM_PEERS=25
VOICE_MAX_ROOMS_PER_USER=1
VOICE_ROOM_CLEANUP_GRACE=30
VOICE_SIGNAL_RATE_LIMIT=10
VOICE_SIGNAL_RATE_BURST=20
VOICE_SUBSCRIBE_RATE_LIMIT=5
VOICE_SUBSCRIBE_RATE_BURST=10

# Push notifications. Desativado por padrão (USE_FCM_RELAY=false): nenhum
# papo-push é iniciado e não há entrega push. O backend NUNCA envia push
# diretamente; quando habilitado, ele supervisiona o papo-push (os/exec).
#
# USE_FCM_RELAY=true + FCM_RELAY_URL vazio  → papo-push fala direto com o FCM
#   (precisa de GOOGLE_APPLICATION_CREDENTIALS, credencial de service account).
# USE_FCM_RELAY=true + FCM_RELAY_URL definido → papo-push encaminha ao relay
#   remoto (autenticado por FCM_RELAY_TOKEN; FCM_RELAY_TOKEN obrigatório).
USE_FCM_RELAY=false
FCM_RELAY_URL=
FCM_RELAY_TOKEN=
# Caminho do binário do papo-push (buildado para backend/papo-push).
FCM_RELAY_BINARY=./papo-push
# Máximo de reinícios consecutivos do papo-push antes de desistir
# (push fica indisponível, backend continua rodando).
FCM_RELAY_RESTART_MAX=10
GOOGLE_APPLICATION_CREDENTIALS=credenciais

# Worker papo-push (consumido pelo papo-push, herdado do backend).
PUSH_HEALTH_PORT=9473
PUSH_WORKERS=2
PUSH_BATCH_SIZE=50
PUSH_MAX_ATTEMPTS=8
# Timeout de cada request de entrega (segundos).
PUSH_REQUEST_TIMEOUT=5
# full | generic | hidden — corpo da notificação push.
# full: "<autor>: <preview>"; generic: "<autor> enviou uma mensagem";
# hidden: "Nova mensagem".
PUSH_PREVIEW=full
